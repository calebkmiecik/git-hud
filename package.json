{
  "name": "git-hud",
  "version": "0.1.0",
  "description": "Always-on-top overlay showing git branch status for tracked repos",
  "main": "src/main.js",
  "type": "commonjs",
  "author": "Caleb",
  "scripts": {
    "start": "node scripts/launch.js",
    "dev": "node scripts/launch.js --watch",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.caleb.githud",
    "productName": "git-hud",
    "files": ["src/**/*", "config.example.json", "icon.ico"],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "electronmon": "^2.0.4"
  }
}
